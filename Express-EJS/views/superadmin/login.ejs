<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Super Admin Login</title>
    <style>
      :root {
        --bg-1: #020617;
        --bg-2: #0b1222;
        --panel: rgba(15, 23, 42, 0.86);
        --panel-border: rgba(148, 163, 184, 0.28);
        --text: #e2e8f0;
        --muted: #94a3b8;
        --accent: #22d3ee;
        --accent-hover: #67e8f9;
        --danger-bg: rgba(248, 113, 113, 0.12);
        --danger-border: rgba(248, 113, 113, 0.45);
        --danger-text: #fecaca;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
        font-family: "Segoe UI", "Inter", sans-serif;
        color: var(--text);
        position: relative;
        overflow: hidden;
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        background-image: url("https://images.unsplash.com/photo-1486006920555-c77dcf18193c?auto=format&fit=crop&w=1800&q=80");
        background-size: cover;
        background-position: center;
        filter: blur(5px);
        transform: scale(1.06);
        z-index: -2;
        pointer-events: none;
      }

      body::after {
        content: "";
        position: fixed;
        inset: 0;
        background: linear-gradient(135deg, rgba(2, 6, 23, 0.72), rgba(15, 23, 42, 0.6));
        z-index: -1;
        pointer-events: none;
      }

      .box {
        width: min(100%, 480px);
        background: var(--panel);
        border: 1px solid var(--panel-border);
        border-radius: 16px;
        padding: 28px;
        box-shadow: 0 20px 55px rgba(2, 6, 23, 0.48);
      }

      h2 {
        margin: 0 0 8px;
        font-size: clamp(1.6rem, 4vw, 2rem);
        letter-spacing: 0.3px;
      }

      .subtitle {
        margin: 0 0 20px;
        color: var(--muted);
        line-height: 1.6;
      }

      .error {
        margin: 0 0 14px;
        padding: 10px 12px;
        border-radius: 10px;
        border: 1px solid var(--danger-border);
        background: var(--danger-bg);
        color: var(--danger-text);
      }

      .form-group {
        margin-top: 12px;
      }

      label {
        display: block;
        margin: 0 0 8px;
        color: #cbd5e1;
        font-size: 0.92rem;
      }

      input,
      button {
        width: 100%;
        border-radius: 10px;
      }

      input {
        border: 1px solid #334155;
        background: rgba(2, 6, 23, 0.75);
        color: #f8fafc;
        padding: 12px 14px;
        font-size: 1rem;
      }

      input:focus {
        outline: none;
        border-color: rgba(34, 211, 238, 0.8);
        box-shadow: 0 0 0 3px rgba(34, 211, 238, 0.18);
      }

      button {
        margin-top: 18px;
        border: none;
        cursor: pointer;
        padding: 12px 14px;
        font-size: 1rem;
        font-weight: 700;
        color: #06203b;
        background: var(--accent);
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
      }

      button:hover {
        background: var(--accent-hover);
        transform: translateY(-1px);
        box-shadow: 0 10px 22px rgba(34, 211, 238, 0.28);
      }

      .hint {
        margin: 14px 0 0;
        color: var(--muted);
        line-height: 1.6;
      }

      @media (max-width: 520px) {
        .box {
          padding: 22px;
        }
      }
    </style>
  </head>
  <body>
    <div class="box">
      <h2>Super Admin Login</h2>
      <p class="subtitle">Access the secure control panel to create and manage admin accounts.</p>
      <% if (error) { %>
      <p class="error"><%= error %></p>
      <% } %>
      <form action="/superadmin/login" method="POST">
        <div class="form-group">
          <label for="email">Email</label>
          <input id="email" type="email" name="email" placeholder="Enter super admin email" required />
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input id="password" type="password" name="password" placeholder="Enter password" required />
        </div>
        <button type="submit">Login</button>
      </form>
      <p class="hint">Only super admin can create/manage admin accounts.</p>
    </div>
  </body>
</html>
