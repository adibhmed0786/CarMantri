<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <%- include("../partials/navbar") %>

    <section class="auth-section">
      <div class="container auth-container">
        <div class="auth-card">
          <h2>Forgot Password</h2>
          <p class="auth-subtitle">Enter your registered email address. We will generate a reset link.</p>

          <% if (error) { %>
          <p class="auth-error"><%= error %></p>
          <% } %>

          <% if (message) { %>
          <p class="auth-success"><%= message %></p>
          <% } %>

          <% if (resetLink) { %>
          <p class="auth-dev-note">
            Development reset link:
            <a class="auth-inline-link" href="<%= resetLink %>">Reset Password</a>
          </p>
          <% } %>

          <form action="/forgot-password" method="POST" class="auth-form">
            <input type="email" name="email" placeholder="Email" required />
            <button type="submit" class="btn auth-submit-btn">Generate Reset Link</button>
          </form>

          <p class="auth-switch">Remembered it? <a href="/login">Log in</a></p>
        </div>
      </div>
    </section>
  </body>
</html>
