<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard</title>
    <style>
      html {
        overflow-y: scroll;
        scrollbar-gutter: stable;
      }
      body {
        font-family: Arial, sans-serif;
        background: #0f172a;
        color: #e2e8f0;
        margin: 0;
        padding: 20px;
      }
      .header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: 1200px;
        margin: 0 auto 40px;
      }
      .header h2 {
        margin: 0;
      }
      .user-info {
        display: flex;
        align-items: center;
        gap: 16px;
      }
      .avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #dc2626;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 18px;
      }
      .container {
        max-width: 1200px;
        margin: 0 auto;
        min-height: calc(100vh - 170px);
      }
      .nav-tabs {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
        border-bottom: 1px solid #334155;
        padding-bottom: 10px;
      }
      .nav-tabs a {
        padding: 10px 16px;
        text-decoration: none;
        color: #cbd5e1;
        border-bottom: 3px solid transparent;
        cursor: pointer;
      }
      .nav-tabs a.active {
        color: #22d3ee;
        border-bottom-color: #22d3ee;
      }
      .tab-content {
        display: none;
        min-height: 520px;
      }
      .tab-content.active {
        display: block;
      }
      .form-group {
        margin-bottom: 16px;
      }
      input,
      textarea {
        width: 100%;
        padding: 12px;
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 8px;
        color: #fff;
        font-family: Arial, sans-serif;
      }
      textarea {
        resize: vertical;
        min-height: 100px;
      }
      button {
        padding: 12px 24px;
        background: #22d3ee;
        color: #0f172a;
        border: none;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
      }
      button:hover {
        background: #67e8f9;
      }
      .logout-btn {
        background: #f87171;
        color: #fff;
      }
      .logout-btn:hover {
        background: #ef4444;
      }
      .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 20px;
      }
      .service-card {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 8px;
        overflow: hidden;
      }
      .service-card img {
        width: 100%;
        height: 180px;
        object-fit: cover;
      }
      .service-card-body {
        padding: 16px;
      }
      .service-card-body h3 {
        margin: 0 0 8px;
        color: #22d3ee;
      }
      .service-card-body p {
        margin: 0 0 12px;
        color: #cbd5e1;
        font-size: 14px;
      }
      .service-price {
        margin: 0 0 12px;
        font-size: 16px;
        font-weight: 700;
        color: #fbbf24;
      }
      .delete-btn {
        background: #f87171;
        padding: 8px 16px;
        font-size: 14px;
      }
      .delete-btn:hover {
        background: #ef4444;
      }
      .actions-row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
      }
      .edit-btn {
        background: #fbbf24;
        padding: 8px 16px;
        font-size: 14px;
        color: #0f172a;
      }
      .edit-btn:hover {
        background: #f59e0b;
      }
      .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(2, 6, 23, 0.72);
        align-items: center;
        justify-content: center;
        padding: 20px;
        z-index: 9999;
      }
      .modal-card {
        width: 100%;
        max-width: 560px;
        background: #111827;
        border: 1px solid #334155;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
      }
      .modal-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 18px;
      }
      .modal-head h3 {
        margin: 0;
      }
      .close-modal-btn {
        background: transparent;
        color: #cbd5e1;
        border: none;
        font-size: 28px;
        padding: 0;
        line-height: 1;
      }
      .services-actions {
        margin-top: 14px;
        display: flex;
        justify-content: center;
      }
      .load-more-btn {
        background: #334155;
        color: #e2e8f0;
      }
      .load-more-btn:hover {
        background: #475569;
      }
      .feedback-toolbar {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: end;
        margin-bottom: 18px;
      }
      .feedback-toolbar .form-group {
        margin-bottom: 0;
        min-width: 220px;
      }
      .feedback-toolbar select {
        width: 100%;
        padding: 11px;
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 8px;
        color: #fff;
      }
      .feedback-list {
        display: grid;
        gap: 12px;
      }
      .feedback-card {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 10px;
        padding: 14px;
      }
      .feedback-card-top {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 8px;
      }
      .feedback-service {
        margin: 0;
        color: #22d3ee;
        font-size: 17px;
      }
      .feedback-user {
        margin: 2px 0 0;
        font-size: 13px;
        color: #94a3b8;
      }
      .feedback-rating {
        margin: 0;
        color: #fbbf24;
        font-weight: 700;
      }
      .feedback-comment {
        margin: 8px 0 0;
        color: #cbd5e1;
        line-height: 1.5;
      }
      .feedback-date {
        margin-top: 8px;
        font-size: 12px;
        color: #94a3b8;
      }
    </style>
  </head>
  <body>
    <div class="header">
      <h2>Admin Dashboard</h2>
      <div class="user-info">
        <div class="avatar">
          <%= (admin.name || "A").charAt(0).toUpperCase() %>
        </div>
        <div>
          <p style="margin: 0; font-weight: 700"><%= admin.name %></p>
          <p style="margin: 0; font-size: 14px; color: #94a3b8">
            <%= admin.email %>
          </p>
        </div>
        <form action="/admin/logout" method="POST" style="margin: 0">
          <button type="submit" class="logout-btn">Logout</button>
        </form>
      </div>
    </div>

    <div class="container">
      <div class="nav-tabs">
        <a href="#" class="tab-link active" data-tab="add-service"
          >Add Service</a
        >
        <a href="#" class="tab-link" data-tab="all-services">All Services</a>
        <a href="#" class="tab-link" data-tab="feedback-tab">Completed Reviews</a>
        <a
          href="/admin/bookings"
          style="
            padding: 10px 16px;
            text-decoration: none;
            color: #cbd5e1;
            border-bottom: 3px solid transparent;
          "
          >Bookings</a
        >
      </div>

      <!-- Add Service Tab -->
      <div id="add-service" class="tab-content active">
        <h3>Add New Service</h3>
        <form id="add-service-form" style="max-width: 500px">
          <div class="form-group">
            <label for="service-name">Service Name</label>
            <input
              type="text"
              id="service-name"
              placeholder="e.g., Oil Change"
              required
            />
          </div>
          <div class="form-group">
            <label for="service-description">Description</label>
            <textarea
              id="service-description"
              placeholder="Describe the service..."
              required
            ></textarea>
          </div>
          <div class="form-group">
            <label for="service-image">Image URL</label>
            <input
              type="url"
              id="service-image"
              placeholder="https://example.com/image.jpg"
              required
            />
          </div>
          <div class="form-group">
            <label for="service-price">Price (INR)</label>
            <input
              type="number"
              id="service-price"
              placeholder="e.g., 1499"
              min="0"
              step="1"
              required
            />
          </div>
          <button type="submit">Add Service</button>
          <p id="add-message" style="margin-top: 10px; display: none"></p>
        </form>
      </div>

      <!-- All Services Tab -->
      <div id="all-services" class="tab-content">
        <h3>All Services</h3>
        <div class="services-grid" id="services-container">
          <p>Loading services...</p>
        </div>
        <div class="services-actions" id="services-actions" style="display: none">
          <button type="button" class="load-more-btn" id="load-more-btn">Load More</button>
        </div>
      </div>

      <div id="feedback-tab" class="tab-content">
        <h3>Completed Customer Reviews</h3>
        <div class="feedback-toolbar">
          <div class="form-group">
            <label for="feedback-service-filter">Service</label>
            <select id="feedback-service-filter">
              <option value="all">All Services</option>
            </select>
          </div>
          <div class="form-group">
            <label for="feedback-rating-filter">Rating</label>
            <select id="feedback-rating-filter">
              <option value="all">All Ratings</option>
              <option value="5">5 Stars</option>
              <option value="4">4 Stars</option>
              <option value="3">3 Stars</option>
              <option value="2">2 Stars</option>
              <option value="1">1 Star</option>
            </select>
          </div>
          <button type="button" id="apply-feedback-filter-btn">Apply Filters</button>
        </div>
        <div id="feedback-container" class="feedback-list">
          <p>Open this tab to load customer feedback.</p>
        </div>
      </div>
    </div>

    <div id="edit-modal" class="modal-overlay" aria-hidden="true">
      <div class="modal-card">
        <div class="modal-head">
          <h3>Edit Service</h3>
          <button type="button" class="close-modal-btn" id="close-edit-modal-btn">&times;</button>
        </div>
        <form id="edit-service-form">
          <input type="hidden" id="edit-service-id" />
          <div class="form-group">
            <label for="edit-service-name">Service Name</label>
            <input type="text" id="edit-service-name" required />
          </div>
          <div class="form-group">
            <label for="edit-service-description">Description</label>
            <textarea id="edit-service-description" required></textarea>
          </div>
          <div class="form-group">
            <label for="edit-service-image">Image URL</label>
            <input type="url" id="edit-service-image" required />
          </div>
          <div class="form-group">
            <label for="edit-service-price">Price (INR)</label>
            <input type="number" id="edit-service-price" min="0" step="1" required />
          </div>
          <div style="display: flex; gap: 10px; flex-wrap: wrap">
            <button type="submit">Update Service</button>
            <button type="button" class="logout-btn" id="cancel-edit-btn">Cancel</button>
          </div>
          <p id="edit-message" style="margin-top: 10px; display: none"></p>
        </form>
      </div>
    </div>

    <script>
      const initialServices = <%- JSON.stringify(initialServices || []) %>;
      const initialHasMore = <%- JSON.stringify(Boolean(initialHasMore)) %>;
      let servicesCache = Array.isArray(initialServices) ? initialServices : [];
      let isServicesLoaded = servicesCache.length > 0;
      let isServicesLoading = false;
      let hasMoreServices = initialHasMore;
      let currentPage = 1;
      const pageSize = 12;
      const servicesContainer = document.getElementById("services-container");
      const servicesActions = document.getElementById("services-actions");
      const loadMoreBtn = document.getElementById("load-more-btn");
      const feedbackContainer = document.getElementById("feedback-container");
      const feedbackServiceFilter = document.getElementById("feedback-service-filter");
      const feedbackRatingFilter = document.getElementById("feedback-rating-filter");
      const applyFeedbackFilterBtn = document.getElementById("apply-feedback-filter-btn");
      let isFeedbackLoaded = false;
      let isFeedbackLoading = false;

      const allowedTabs = new Set(["add-service", "all-services", "feedback-tab"]);

      function activateTab(tabName, shouldSyncUrl = true) {
        const safeTab = allowedTabs.has(tabName) ? tabName : "add-service";

        document
          .querySelectorAll(".tab-link")
          .forEach((l) => l.classList.remove("active"));
        document
          .querySelectorAll(".tab-content")
          .forEach((t) => t.classList.remove("active"));

        const activeLink = document.querySelector(`.tab-link[data-tab="${safeTab}"]`);
        if (activeLink) {
          activeLink.classList.add("active");
        }

        const activeContent = document.getElementById(safeTab);
        if (activeContent) {
          activeContent.classList.add("active");
        }

        if (safeTab === "all-services") {
          if (isServicesLoaded) {
            displayServices(servicesCache);
          }
          loadServices();
        }

        if (safeTab === "feedback-tab") {
          loadFeedback();
        }

        if (shouldSyncUrl) {
          const url = new URL(window.location.href);
          url.searchParams.set("tab", safeTab);
          window.history.replaceState({}, "", url);
        }
      }

      // Tab switching
      document.querySelectorAll(".tab-link").forEach((link) => {
        link.addEventListener("click", (e) => {
          e.preventDefault();
          activateTab(link.getAttribute("data-tab"));
        });
      });

      const initialTab = new URLSearchParams(window.location.search).get("tab");
      activateTab(initialTab || "add-service", false);

      // Add Service Form
      document
        .getElementById("add-service-form")
        .addEventListener("submit", async (e) => {
          e.preventDefault();

          const name = document.getElementById("service-name").value;
          const description = document.getElementById(
            "service-description",
          ).value;
          const image = document.getElementById("service-image").value;
          const price = document.getElementById("service-price").value;
          const messageEl = document.getElementById("add-message");

          try {
            const res = await fetch("/admin/services", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ name, description, image, price }),
            });

            const data = await res.json();
            if (res.ok) {
              messageEl.style.color = "#22d3ee";
              messageEl.textContent = "✓ Service added successfully!";
              servicesCache = [data.service, ...servicesCache];
              isServicesLoaded = true;
              if (document.getElementById("all-services").classList.contains("active")) {
                displayServices(servicesCache);
              }
              document.getElementById("add-service-form").reset();
              setTimeout(() => {
                messageEl.style.display = "none";
              }, 3000);
            } else {
              messageEl.style.color = "#f87171";
              messageEl.textContent = "✗ " + data.error;
            }
            messageEl.style.display = "block";
          } catch (error) {
            messageEl.style.color = "#f87171";
            messageEl.textContent = "✗ Something went wrong";
            messageEl.style.display = "block";
          }
        });

      // Load Services
      async function loadServices(forceRefresh = false) {
        if (isServicesLoading) return;
        if (!forceRefresh && isServicesLoaded) return;

        isServicesLoading = true;
        servicesContainer.innerHTML = "<p>Loading...</p>";
        servicesActions.style.display = "none";
        currentPage = 1;

        try {
          const adminRes = await fetch(`/api/admin/services?page=${currentPage}&limit=${pageSize}`);
          if (adminRes.ok) {
            const payload = await adminRes.json();
            servicesCache = payload.items || [];
            hasMoreServices = Boolean(payload.hasMore);
            isServicesLoaded = true;
            displayServices(servicesCache);
          } else {
            servicesContainer.innerHTML = "<p>Failed to load services</p>";
          }
        } catch (error) {
          servicesContainer.innerHTML = "<p>Failed to load services</p>";
        } finally {
          isServicesLoading = false;
        }
      }

      async function loadMoreServices() {
        if (isServicesLoading || !hasMoreServices) return;

        isServicesLoading = true;
        loadMoreBtn.textContent = "Loading...";
        loadMoreBtn.disabled = true;

        try {
          const nextPage = currentPage + 1;
          const res = await fetch(`/api/admin/services?page=${nextPage}&limit=${pageSize}`);
          if (!res.ok) throw new Error("Failed to load more");

          const payload = await res.json();
          const nextItems = payload.items || [];
          servicesCache = [...servicesCache, ...nextItems];
          currentPage = nextPage;
          hasMoreServices = Boolean(payload.hasMore);
          displayServices(servicesCache);
        } catch (error) {
          alert("Failed to load more services");
        } finally {
          isServicesLoading = false;
          loadMoreBtn.textContent = "Load More";
          loadMoreBtn.disabled = false;
        }
      }

      function displayServices(services) {
        if (services.length === 0) {
          servicesContainer.innerHTML = "<p>No services added yet</p>";
          servicesActions.style.display = "none";
          return;
        }

        const formatPrice = (value) => {
          const numericValue = Number(value);
          if (Number.isNaN(numericValue)) return "Price not set";
          return `INR ${numericValue.toLocaleString("en-IN")}`;
        };

        servicesContainer.innerHTML = services
          .map(
            (service) => `
          <div class="service-card">
            <img src="${service.image}" alt="${service.name}" decoding="async" />
            <div class="service-card-body">
              <h3>${service.name}</h3>
              <p>${service.description}</p>
              <p class="service-price">${formatPrice(service.price)}</p>
              <div class="actions-row">
                <button class="edit-btn" onclick="openEditModal('${service._id}')">Edit</button>
                <button class="delete-btn" onclick="deleteService('${service._id}')">Delete</button>
              </div>
            </div>
          </div>
        `,
          )
          .join("");

        servicesActions.style.display = hasMoreServices ? "flex" : "none";
      }

      loadMoreBtn.addEventListener("click", loadMoreServices);

      if (isServicesLoaded) {
        displayServices(servicesCache);
      }

      async function loadFeedback(forceRefresh = false) {
        if (isFeedbackLoading) return;
        if (isFeedbackLoaded && !forceRefresh) return;

        isFeedbackLoading = true;
        feedbackContainer.innerHTML = "<p>Loading feedback...</p>";

        try {
          const params = new URLSearchParams();
          if (feedbackServiceFilter.value !== "all") {
            params.set("service", feedbackServiceFilter.value);
          }
          if (feedbackRatingFilter.value !== "all") {
            params.set("rating", feedbackRatingFilter.value);
          }

          const res = await fetch(`/api/admin/feedback?${params.toString()}`);
          const data = await res.json();

          if (!res.ok) {
            feedbackContainer.innerHTML = `<p>${data.error || "Failed to load feedback"}</p>`;
            return;
          }

          populateServiceFilter(data.serviceOptions || []);
          renderFeedback(data.items || []);
          isFeedbackLoaded = true;
        } catch (error) {
          feedbackContainer.innerHTML = "<p>Failed to load feedback</p>";
        } finally {
          isFeedbackLoading = false;
        }
      }

      function populateServiceFilter(options) {
        const selected = feedbackServiceFilter.value || "all";
        feedbackServiceFilter.innerHTML = '<option value="all">All Services</option>';
        options.forEach((service) => {
          feedbackServiceFilter.innerHTML += `<option value="${service._id}">${service.name}</option>`;
        });
        feedbackServiceFilter.value = selected;
      }

      function renderFeedback(items) {
        if (!items.length) {
          feedbackContainer.innerHTML = "<p>No feedback found for selected filters.</p>";
          return;
        }

        const stars = (rating) => "★".repeat(rating) + "☆".repeat(5 - rating);

        feedbackContainer.innerHTML = items
          .map((item) => {
            const serviceName = item.service?.name || item.serviceDetails?.name || "Service";
            const userName = item.user?.name || "Unknown User";
            const userEmail = item.user?.email || "";
            const comment = item.feedbackComment || "No written comment provided.";
            const dateText = item.feedbackSubmittedAt
              ? new Date(item.feedbackSubmittedAt).toLocaleDateString()
              : "Date not available";

            return `
              <article class="feedback-card">
                <div class="feedback-card-top">
                  <div>
                    <h4 class="feedback-service">${serviceName}</h4>
                    <p class="feedback-user">${userName}${userEmail ? ` (${userEmail})` : ""}</p>
                  </div>
                  <p class="feedback-rating">${stars(Number(item.feedbackRating || 0))} (${item.feedbackRating || "-"}/5)</p>
                </div>
                <p class="feedback-comment">${comment}</p>
                <p class="feedback-date">Submitted on ${dateText}</p>
              </article>
            `;
          })
          .join("");
      }

      applyFeedbackFilterBtn.addEventListener("click", () => {
        isFeedbackLoaded = false;
        loadFeedback(true);
      });

      const editModal = document.getElementById("edit-modal");
      const editMessage = document.getElementById("edit-message");

      function closeEditModal() {
        editModal.style.display = "none";
        editModal.setAttribute("aria-hidden", "true");
        editMessage.style.display = "none";
      }

      function openEditModal(id) {
        const service = servicesCache.find((item) => item._id === id);
        if (!service) {
          alert("Service not found");
          return;
        }

        document.getElementById("edit-service-id").value = service._id;
        document.getElementById("edit-service-name").value = service.name || "";
        document.getElementById("edit-service-description").value = service.description || "";
        document.getElementById("edit-service-image").value = service.image || "";
        document.getElementById("edit-service-price").value = service.price ?? "";

        editModal.style.display = "flex";
        editModal.setAttribute("aria-hidden", "false");
      }

      document.getElementById("close-edit-modal-btn").addEventListener("click", closeEditModal);
      document.getElementById("cancel-edit-btn").addEventListener("click", closeEditModal);

      editModal.addEventListener("click", (e) => {
        if (e.target === editModal) {
          closeEditModal();
        }
      });

      document.getElementById("edit-service-form").addEventListener("submit", async (e) => {
        e.preventDefault();

        const id = document.getElementById("edit-service-id").value;
        const name = document.getElementById("edit-service-name").value;
        const description = document.getElementById("edit-service-description").value;
        const image = document.getElementById("edit-service-image").value;
        const price = document.getElementById("edit-service-price").value;

        try {
          const res = await fetch(`/admin/services/${id}`, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ name, description, image, price }),
          });

          const data = await res.json();
          if (res.ok) {
            editMessage.style.color = "#22d3ee";
            editMessage.textContent = "✓ Service updated successfully!";
            editMessage.style.display = "block";
            servicesCache = servicesCache.map((service) =>
              service._id === id ? data.service : service,
            );
            displayServices(servicesCache);
            setTimeout(() => {
              closeEditModal();
            }, 900);
          } else {
            editMessage.style.color = "#f87171";
            editMessage.textContent = "✗ " + data.error;
            editMessage.style.display = "block";
          }
        } catch (error) {
          editMessage.style.color = "#f87171";
          editMessage.textContent = "✗ Something went wrong";
          editMessage.style.display = "block";
        }
      });

      async function deleteService(id) {
        if (!confirm("Are you sure you want to delete this service?")) return;

        try {
          const res = await fetch(`/admin/services/${id}`, {
            method: "DELETE",
          });
          if (res.ok) {
            servicesCache = servicesCache.filter((service) => service._id !== id);
            displayServices(servicesCache);
          }
        } catch (error) {
          alert("Failed to delete service");
        }
      }

      if (!isServicesLoaded) {
        loadServices();
      }
    </script>
  </body>
</html>
